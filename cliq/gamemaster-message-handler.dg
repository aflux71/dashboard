// Game Master bot: Message handler.
// Forwards every DM to the Game Master server (Base44 app "Game Master"), which runs
// the solo games and keeps everything else (spy votes, Two Truths statements) for the
// Game Master's next check-in. The bot shows the server's reply as is.
// Replace PASTE_KEY_HERE with the GM_BOT_KEY you set in Base44 (see cliq/README.md).
key = "PASTE_KEY_HERE";
url = "https://game-master-4673b1ce.base44.app/api/cliq";

text = ifnull(message,"").trim();
if(text == "")
{
	return {"text":"I can only read text messages. Type *play* for a quick solo game."};
}
name = ifnull(user.get("first_name"),"");
if(user.get("last_name") != null)
{
	name = name + " " + user.get("last_name");
}
payload = Map();
payload.put("cliq_user_id",ifnull(user.get("id"),""));
payload.put("name",name.trim());
payload.put("email",ifnull(user.get("email"),""));
payload.put("text",text);
headers = Map();
headers.put("Authorization","Bearer " + key);
headers.put("Content-Type","application/json");
try
{
	result = invokeurl
	[
		url :url
		type :POST
		parameters:payload.toString()
		headers:headers
		detailed:true
	];
	answer = result.get("responseText").toString().toMap();
	if(answer != null && answer.get("text") != null)
	{
		return {"text":answer.get("text")};
	}
	return {"text":"Sorry, the Game Master server answered with error " + result.get("responseCode") + ". Please tell Robert."};
}
catch (e)
{
	return {"text":"Sorry, I couldn't reach the Game Master server just now. Try again in a minute, and tell Robert if it keeps happening."};
}
